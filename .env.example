# ============================================================================================================
# Environment variables. Copy to .env for local use; on a host, set the same names in its dashboard.
# Never commit real values. .env is git-ignored.
# ============================================================================================================

# ---- REQUIRED: the server will not start without these two -----------------------------------------------
# Supabase project URL and the SECRET (service_role) key. Server-side only, never ship it to a browser.
# The same pair is used for the database AND for Supabase Auth (login, session checks, the admin calls that
# sign users out): there is no separate anon / publishable key. The API enforces login itself; the tables
# also have row-level-security policies that only admit signed-in team members.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key

# ---- Hosting -----------------------------------------------------------------------------------------------
# Port to listen on. Hosting platforms set this themselves; locally it defaults to 3000.
# PORT=3000
# Number of reverse proxies in front of the app (1 on most hosts: Render, Railway, Heroku, Fly...). Set it so the
# login throttle sees each visitor's real IP instead of the proxy's. Leave unset if the server is exposed directly.
# TRUST_PROXY=1

# ---- DronaHQ agents (needed for the run-* endpoints; every call spends DronaHQ credits) --------------------------
# One webhook trigger URL + API key per agent. All 7 are needed for the full pipeline.
DRONAHQ_ICP_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_ICP_WEBHOOK_KEY=your-webhook-api-key
DRONAHQ_RESEARCH_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_RESEARCH_WEBHOOK_KEY=your-webhook-api-key
DRONAHQ_PERSONALIZE_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_PERSONALIZE_WEBHOOK_KEY=your-webhook-api-key
DRONAHQ_STRATEGY_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_STRATEGY_WEBHOOK_KEY=your-webhook-api-key
DRONAHQ_CONVERSATION_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_CONVERSATION_WEBHOOK_KEY=your-webhook-api-key
DRONAHQ_FOLLOWUP_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_FOLLOWUP_WEBHOOK_KEY=your-webhook-api-key
DRONAHQ_VOICE_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-trigger-id
DRONAHQ_VOICE_WEBHOOK_KEY=your-webhook-api-key

# ---- Prospect discovery (POST /campaigns/:id/discover). Neither is a DronaHQ service: no DronaHQ credits. ---------
# Groq extracts prospects from search results; Tavily does the web search.
GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=your-tavily-api-key

# ---- Real email dispatch through Gmail SMTP -------------------------------------------------------------------
# A Google "app password" (16 characters), not your normal password. Without these, email dispatch is only recorded (simulated).
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
# Every real send is redirected to EMAIL_TEST_RECIPIENT (default: EMAIL_USER itself), never to the prospect's address.
# EMAIL_TEST_RECIPIENT=inbox-you-control@example.com

# Audit blind copy: every real email is also sent, as its own SMTP transaction (the address never appears in any header), to this
# address. Fixed for the whole deployment, not per campaign. Leave unset to send no copy.
AUDIT_BCC_EMAIL=audit-inbox@example.com

# ---- Only for `npm run seed:users` (run once, from your own machine; not needed on the server) ------------------
# The team accounts live in Supabase Auth, not on the server. db/team.json (git-ignored, see db/team.example.json) lists them.
# Optional per-user password override, e.g. SEED_PASSWORD_MITRAA=...  (otherwise a strong one is generated and printed once).
